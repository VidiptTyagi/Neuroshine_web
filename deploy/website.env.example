# Server-side env for the Lightsail deploy. Goes to /etc/neuroshine-website/website.env
# on the box (chmod 600, owned by the neuroshine user) — see ../../neuroshine-backend/deploy/README.md §2.8.
#
# NEXT_PUBLIC_* vars are NOT here — those are baked into the build at build
# time (on your laptop/CI), from your own .env.production.local. See
# neuroshine_website/.env.example for those.

RESEND_API_KEY=
RESEND_FROM_EMAIL=NeuroShine <noreply@neuroshine.in>
CONTACT_NOTIFY_EMAIL=neuroshinecdc@gmail.com
