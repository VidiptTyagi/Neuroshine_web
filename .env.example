# ============================================================
# NeuroShine — Public marketing site (Next.js) · env vars
# Copy to `.env.local` and fill in real values. Never commit secrets.
#
# This is a standalone, DATABASE-LESS site: all content is static (SEO-friendly)
# and forms email the clinic directly via Resend. No backend, no database.
#
# NOTE: every NEXT_PUBLIC_* value is baked into the bundle at build time. On
# Vercel, changing one has no effect until you redeploy WITHOUT the build cache.
# ============================================================

# --- Site ---
# Production: https://neuroshine.in  (no "www", no trailing slash — this drives
# the canonical tag, og:url, robots.txt and every sitemap URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) — powers all forms (contact, appointment, newsletter, careers) ---
# Get a key at https://resend.com. Without it, forms still succeed but no email
# is sent (skipped + logged) — handy for local dev, silent breakage in prod.
RESEND_API_KEY=
# Sender address. The domain must be verified in Resend, otherwise sending fails.
# Production uses: NeuroShine <noreply@neuroshine.in>
# For local tests, Resend's sandbox sender only delivers to your own account
# address: NeuroShine <onboarding@resend.dev>
RESEND_FROM_EMAIL=NeuroShine <onboarding@resend.dev>
# Where clinic notifications (new appointment / enquiry / application) are sent.
CONTACT_NOTIFY_EMAIL=neuroshinecdc@gmail.com

# --- Google Maps (contact page) ---
# UNUSED. The contact map is a keyless Google Maps iframe embed, so nothing
# reads this today. Only needed if the map is ever rebuilt on the paid
# Maps JavaScript API (@react-google-maps/api is still in package.json).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console verification token, for the HTML-tag method. The live
# property is verified by a DNS TXT record instead, so this is usually blank.
NEXT_PUBLIC_GSC_VERIFICATION=
